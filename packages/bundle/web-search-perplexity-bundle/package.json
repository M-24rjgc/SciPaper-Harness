{
  "name": "@deepseek-ai/dsh-web-search-perplexity-bundle",
  "description": "Search the web through Perplexity. An API key is required; search remains unavailable until configured.",
  "version": "0.2.0-alpha.5",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-24rjgc/SciPaper-Harness.git",
    "directory": "packages/bundle/web-search-perplexity-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-web-search-perplexity": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scipaper": {
    "kernel": {
      "name": "deepseek-harness",
      "version": "0.2.0-rc.2",
      "revision": "639ed015397290b3745d163aafe02ffee4aa3f84"
    }
  }
}
