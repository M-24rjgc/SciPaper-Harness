    "chunks": [
     {
      "locator": {
       "page": 5
      },
      "text": "W e refer to this model as the factual consis-\ntency checking model ( FactCC)."
     },
     {
      "locator": {
       "page": 6
      },
      "text": "Both FactCC and FactCCX\nmodels substantially outperform classiﬁers trained\non the MNLI and FEVER datasets when evalu-\nated on the CNN/DailyMail test set."
     }
    ]
   },
   {
