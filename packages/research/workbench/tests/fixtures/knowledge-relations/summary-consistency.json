   {
    "id": "8abc86ac-5068-4ff7-a615-356d1885341c",
    "kind": "literature",
    "title": "AlignScore: Evaluating Factual Consistency with A Unified Alignment Function",
    "path": ".research/sources/8abc86ac-5068-4ff7-a615-356d1885341c/reference.json",
    "sha256": "827064f8941a7312467877e3ab714e35ea3a2cf02ff0d361c05064c28d1a0fbe",
    "revision": 1,
    "importedAt": "2026-09-23T20:21:36.501Z",
    "sourceUrl": "https://doi.org/10.18653/v1/2023.acl-long.634",
    "doi": "10.18653/v1/2023.acl-long.634",
    "fullTextPath": ".research/sources/8abc86ac-5068-4ff7-a615-356d1885341c/fulltext.pdf",
    "coverage": "full-text",
    "verified": true,
    "stale": false,
    "chunks": [
     {
      "locator": {
       "key": "title"
      },
      "text": "AlignScore: Evaluating Factual Consistency with A Unified Alignment Function"
     },
     {
      "locator": {
       "page": 1
      },
      "text": "In\nthis paper, we propose ALIGN SCORE , a new\nholistic metric that applies to a variety of fac-\ntual inconsistency scenarios as above."
     },
     {
      "locator": {
       "page": 2
      },
      "text": "We evaluate\nALIGN SCORE on the latest large-scale evaluation\nbenchmarks, including SummaC (Laban et al.,\n2022), TRUE (Honovich et al., 2022b), and other\ntestbeds, which contain a total of 22 challenging\nevaluation datasets."
     },
     {
      "locator": {
       "page": 6
      },
      "text": "We include\nthe latest QAFactEval (Fabbri et al., 2022), QuestE-\nval (Scialom et al., 2021), and FEQA (Durmus\net al., 2020) as our baselines."
     },
     {
      "locator": {
       "page": 7
      },
      "text": "For sentence-level baseline, we use\nSummaC-ZeroShot and SummaC-Conv introduced\nin the SummaC Benchmark (Laban et al., 2022)\nand FactCC (Kryscinski et al., 2020) which is\ntrained on synthetic data."
     }
    ]
   },
